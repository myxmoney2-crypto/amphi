# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Service role key — server only, never exposed to the browser. Used to
# reset course status and as a fallback admin client from the trigger route.
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Anthropic — utilisé côté Next.js UNIQUEMENT pour "Demander une explication
# à AMFI" (Haiku, requête courte et interactive). Le gros du traitement
# (structuration/quiz/carte mentale, modèle principal) tourne à part dans
# l'Edge Function Supabase `process-course`, configurée via
# `supabase secrets set` — cette clé-ci doit donc aussi être ajoutée aux
# variables d'environnement Vercel en prod, en plus des secrets Supabase.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Note : OPENAI_API_KEY n'est pas nécessaire côté Next.js — Whisper est
# uniquement appelé depuis l'Edge Function `process-course`.

# Resend — transactional emails (optional for local dev)
RESEND_API_KEY=re_xxxxxxxx
